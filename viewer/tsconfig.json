{
  // Type-checks the viewer's JavaScript through its JSDoc annotations; emits nothing.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["js/**/*.js", "types/**/*.d.ts", "test/**/*.js"]
}
