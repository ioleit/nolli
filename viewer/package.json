{
  "name": "nolli-viewer",
  "private": true,
  "description": "The nolli viewer: plain ES modules loaded by the browser as they are; Node is only for type checking and tests",
  "type": "module",
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test test/",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "elkjs": "0.9.3",
    "mermaid": "11.17.2",
    "typescript": "7.0.2"
  }
}
